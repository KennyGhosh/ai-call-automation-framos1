    },
    {
      "parameters": {
        "jsCode": "// 1. Get the date string from the Date & Time node's output.\n// Assuming your Date & Time node is named \"Date & Time\"\nconst dateNodeOutput = $node[\"Date & Time\"].json;\nconst now_string = dateNodeOutput.currentDate;\nconst now = new Date(now_string);\n\n// 2. Define the corrected working hours (in 24-hour time, decimal format)\n// Manchester/UK Time\nconst WORKING_HOURS = {\n  // Mon - Thurs (1-4)\n  weekdayStart: 7.5,      // 7:30 AM\n  weekdayEnd: 16.25,      // 4:15 PM (4 + 15/60)\n  // Friday (5)\n  fridayStart: 7.5,       // 7:30 AM\n  fridayEnd: 13.5         // 1:30 PM (13 + 30/60)\n};\n\nconst dayOfWeek = now.getDay(); // 0=Sunday, 1=Monday, ..., 6=Saturday\nconst currentHour = now.getHours() + now.getMinutes() / 60; // Current time as decimal\n\nlet call_status = \"after_hours\";\n\n// 3. Logic to determine status\nif (dayOfWeek === 0 || dayOfWeek === 6) {\n  call_status = \"after_hours\";\n}\nelse if (dayOfWeek >= 1 && dayOfWeek <= 4) {\n  if (currentHour >= WORKING_HOURS.weekdayStart && currentHour <= WORKING_HOURS.weekdayEnd) {\n    call_status = \"during_hours\";\n  }\n}\nelse if (dayOfWeek === 5) {\n  if (currentHour >= WORKING_HOURS.fridayStart && currentHour <= WORKING_HOURS.fridayEnd) {\n    call_status = \"during_hours\";\n  }\n}\n\n// 4. Format Date and Time for Google Sheets\n// 'en-GB' locale for the UK format (DD/MM/YYYY)\nconst formattedDate = now.toLocaleDateString('en-GB'); \n\n// *** MODIFIED FOR 12-HOUR FORMAT ***\nconst formattedTime = now.toLocaleTimeString('en-GB', { \n    hour: '2-digit', \n    minute: '2-digit',\n    hour12: true // Key property for 12-hour format (will include AM/PM)\n});\n\n// 5. Output for the next node (Google Sheets)\nreturn [{\n  json: {\n    // Pass the calculated status (if needed later)\n    call_status: call_status, \n    \n    // Pass the formatted Date and Time for the Google Sheet node to use\n    formattedDate: formattedDate,\n    formattedTime: formattedTime\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
