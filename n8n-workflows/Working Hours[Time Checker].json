    {
      "parameters": {
        "jsCode": "// Get the date string from the previous Date & Time node\n// SIMPLER FIX: Access currentDate directly on the item's JSON\nconst now_string = $json.currentDate; \nconst now = new Date(now_string);\n\n\n// Define the working hours (in 24-hour time, decimal format)\nconst WORKING_HOURS = {\n  // Mon - Thurs (1-4)\n  weekdayStart: 7.30,     // 7:30 AM\n  weekdayEnd: 23.55,     // 4:15 PM (4 + 15/60)\n  // Friday (5)\n  fridayStart: 7.5,      // 7:30 AM\n  fridayEnd: 13.5        // 1:30 PM (13 + 30/60)\n};\n\nconst dayOfWeek = now.getDay(); // 0=Sunday, 1=Monday, ..., 6=Saturday\nconst currentHour = now.getHours() + now.getMinutes() / 60; // Current time as decimal\n\nlet call_status = \"after_hours\";\n\n// 1. Check for Weekends (Sunday=0, Saturday=6)\n//if (dayOfWeek === 0 || dayOfWeek === 6) {\n//  call_status = \"after_hours\";\n//}\n// 2. Check for Monday - Thursday (1-4)\nif (dayOfWeek >= 0 && dayOfWeek <= 6) {\n  if (currentHour >= WORKING_HOURS.weekdayStart && currentHour <= WORKING_HOURS.weekdayEnd) {\n    call_status = \"during_hours\";\n  }\n}\n// 3. Check for Friday (5)\nelse(dayOfWeek === 5)//{\n  if (currentHour >= WORKING_HOURS.fridayStart && currentHour <= WORKING_HOURS.fridayEnd) {\n    call_status = \"during_hours\";\n  }\n//}\n\n// Return the calculated status directly under the key Retell expects\nreturn [{\n  json: {\n    // Retell needs a simple key/value pair it can understand\n    // The key here will be used by the LLM in the prompt!\n    call_status: call_status\n  }\n}];"
      },
